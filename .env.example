# Required: workspace-scoped Managed Agent credentials (never commit real values).
DASHSCOPE_API_KEY=
BAILIAN_WORKSPACE_ID=
BAILIAN_REGION=cn-beijing

# scripts/setup_env.py generates unique local values for these two fields.
ADMIN_PASSWORD=replace-with-a-long-password
COOKIE_SECRET=replace-with-a-random-secret

# Relative to the project working directory. Keep data persistent on upgrades.
DATABASE_PATH=data/claw.db

# Public link for human users to open the binding page; localhost works locally only.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Optional for basic chat. Required for cloud Agent self-service and scheduling Skill.
# Set to your reachable HTTPS origin, e.g. https://bots.example.com (no /api/bot suffix).
CLAW_API_BASE_URL=

# scripts/bootstrap_ma.py --apply creates missing resources and fills these IDs.
# Or use existing resources. Prefer explicit IDs when the workspace has multiple resources.
# If blank, auto-selection works only when exactly one resource of that type exists.
DEFAULT_AGENT_ID=
DEFAULT_ENVIRONMENT_ID=
