[Unit]
Description=ClawMio WeChat Managed Agent bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clawmio
Group=clawmio
WorkingDirectory=/opt/clawmio
Environment=HOST=127.0.0.1
Environment=PORT=8000
ExecStart=/usr/bin/bash /opt/clawmio/start.sh run
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
